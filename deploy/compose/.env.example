# Copy to .env or run configure.sh / configure.ps1. Never commit .env.
MINTAPI_IMAGE=your-dockerhub-account/mintapi
MINTAPI_VERSION=0.1.0
MINTAPI_BIND=127.0.0.1
MINTAPI_PORT=8080
MINTAPI_API_KEY=replace-with-random-hex
OSU_CLIENT_ID=0
OSU_CLIENT_SECRET=replace-with-osu-client-secret
# Hex avoids connection-string and Redis config metacharacters.
MYSQL_PASSWORD=replace-with-random-hex
MYSQL_ROOT_PASSWORD=replace-with-another-random-hex
REDIS_PASSWORD=replace-with-another-random-hex
