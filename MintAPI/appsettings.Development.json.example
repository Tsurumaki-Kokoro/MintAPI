{
  "ApiKey": "<自拟一个高强度随机串>",
  "OsuApi": {
    "ClientId": 24578,
    "ClientSecret": "<osu! 账号设置 → OAuth 应用 里的 Client Secret>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=mintapi;User=root;Password=<MySQL 密码>;",
    "Redis": "localhost:6379,defaultDatabase=1"
  },
  "MatchLive": {
    "PollSeconds": 10,
    "RequestBudgetPerMinute": 24,
    "MaxMatches": 4,
    "MaxSubscriptionsPerScope": 3,
    "LeaseMinutes": 30,
    "RetentionMinutes": 60,
    "MaxUpdates": 1000,
    "MockEnabled": false,
    "MockAutoAdvanceSeconds": 30
  },
  "CacheDir": "cache",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "BeatmapPreview": {
    "ExecutablePath": "tools/osu-preview/osu-beatmap-preview-cli",
    "MaxConcurrency": 1,
    "ImageTimeoutSeconds": 120,
    "VideoTimeoutSeconds": 300,
    "MaxVideoDurationSeconds": 60,
    "MaxGifDurationSeconds": 6
  }
}
