<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- XML 文档注释：OpenAPI 描述文字的唯一来源，见 OpenApi/XmlCommentsProvider.cs -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- 注释只写给控制器；其余公开成员缺注释不告警 -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <RustCrateDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', 'native', 'rosu-pp-ffi'))</RustCrateDir>
        <RustReleaseDir>$([MSBuild]::NormalizeDirectory('$(RustCrateDir)', 'target', 'release'))</RustReleaseDir>
        <RustNativeLib Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(RustReleaseDir)rosu_pp_ffi.dll</RustNativeLib>
        <RustNativeLib Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(RustReleaseDir)librosu_pp_ffi.dylib</RustNativeLib>
        <RustNativeLib Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(RustReleaseDir)librosu_pp_ffi.so</RustNativeLib>
    </PropertyGroup>

    <ItemGroup>
        <!-- Web / OpenAPI -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.14.3" />

        <!-- ORM -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0"/>

        <!-- Redis -->
        <PackageReference Include="StackExchange.Redis" Version="2.8.16"/>

        <!-- Playwright -->
        <PackageReference Include="Microsoft.Playwright" Version="1.51.0"/>

        <!-- 模板引擎 -->
        <PackageReference Include="Scriban" Version="5.12.1" NoWarn="NU1902;NU1903;NU1904"/>

        <!-- 日志 -->
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.3"/>
        <PackageReference Include="Serilog.Sinks.File" Version="6.0.0"/>
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- MintOsuApi 库引用 -->
        <ProjectReference Include="..\..\mint-osuapi\src\MintOsuApi\MintOsuApi.csproj" />
    </ItemGroup>

    <!-- Install the pinned preview CLI before publishing; preserve executable mode on Unix. -->
    <ItemGroup>
        <Content Include="tools/osu-preview/**/*" Exclude="tools/osu-preview/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Update="tools/osu-preview/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="RequirePreviewCliForPublish" BeforeTargets="ComputeFilesToPublish">
        <PropertyGroup>
            <PreviewCliRid Condition="Exists('$(MSBuildProjectDirectory)/tools/osu-preview/runtime-id.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/tools/osu-preview/runtime-id.txt').Trim())</PreviewCliRid>
        </PropertyGroup>
        <Error Condition="'$(PreviewCliRid)' == ''" Text="Preview CLI platform manifest missing. Run scripts/install-preview-cli.py on the target platform." />
        <Error Condition="'$(RuntimeIdentifier)' != '' And '$(PreviewCliRid)' != '$(RuntimeIdentifier)'"
               Text="Preview CLI platform $(PreviewCliRid) does not match publish RuntimeIdentifier $(RuntimeIdentifier)." />
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/tools/osu-preview/osu-beatmap-preview-cli') And !Exists('$(MSBuildProjectDirectory)/tools/osu-preview/osu-beatmap-preview-cli.exe')"
               Text="Install the pinned preview CLI for the publish platform with scripts/install-preview-cli.py before publishing." />
    </Target>

    <!-- rosu-pp-ffi: 增量 cargo build + 复制原生库 -->
    <ItemGroup>
        <RustSources Include="$(RustCrateDir)src/**/*.rs" />
        <RustSources Include="$(RustCrateDir)Cargo.toml" />
        <RustSources Include="$(RustCrateDir)Cargo.lock" />
    </ItemGroup>

    <Target Name="BuildRosuPpFfi"
            BeforeTargets="PrepareForBuild"
            Inputs="@(RustSources)"
            Outputs="$(RustCrateDir)target/release/.msbuild-stamp">
        <Message Text="[rosu-pp-ffi] Running cargo build --release..." Importance="high" />
        <Exec Command="cargo build --release"
              WorkingDirectory="$(RustCrateDir)"
              EnvironmentVariables="CARGO_TERM_COLOR=never" />
        <Touch Files="$(RustCrateDir)target/release/.msbuild-stamp" AlwaysCreate="true" />
    </Target>

    <!-- 原生库复制：每次 Build/Publish 前确保 dylib/so/dll 在输出目录 -->
    <Target Name="CopyRosuPpFfiNative" BeforeTargets="Build;Publish" DependsOnTargets="BuildRosuPpFfi">
        <Copy SourceFiles="$(RustNativeLib)"
              DestinationFolder="$(OutDir)"
              SkipUnchangedFiles="true" />
    </Target>

    <!-- 单一来源 RosuPP.cs，从 native/ 链接进来 -->
    <ItemGroup>
        <Compile Include="$(RustCrateDir)RosuPP.cs" Link="rosu_pp\RosuPP.cs" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <Content Update="Rendering/MultiplayerTheme/mock/*.json" CopyToOutputDirectory="PreserveNewest" />
        <!-- 渲染模板：复制到输出目录，保持相对路径结构 -->
        <Content Include="Rendering\**\*.html">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <!-- wwwroot 静态资源：调试时同样复制到输出目录 -->
        <Content Update="wwwroot\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="wwwroot\assets\beatmap\default\__pycache__\__init__.cpython-311.pyc" />
      <_ContentIncludedByDefault Remove="wwwroot\assets\match_history\default\__pycache__\__init__.cpython-311.pyc" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="cache\avatar\" />
      <Folder Include="cache\beatmap\osu_file\" />
      <Folder Include="logs\" />
    </ItemGroup>

</Project>
