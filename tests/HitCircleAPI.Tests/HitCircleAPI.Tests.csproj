<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\HitCircleAPI\HitCircleAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures/match-109850222.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/3881559.osu" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <PpNativeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">librosu_pp_ffi.dylib</PpNativeName>
    <PpNativeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">librosu_pp_ffi.so</PpNativeName>
    <PpNativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">rosu_pp_ffi.dll</PpNativeName>
  </PropertyGroup>

  <Target Name="CopyPpNativeForTests" AfterTargets="Build">
    <Copy SourceFiles="../../native/rosu-pp-ffi/target/release/$(PpNativeName)"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
