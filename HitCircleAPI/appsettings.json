{
  // 本文件是入库的模板，不含任何真实凭据。
  // 空值不是"用默认值"的意思 —— ApiKey 为空会让进程直接启动失败（见 ApiKeyMiddleware）。
  // 本地开发把真实值写进 appsettings.Development.json（已 gitignore，可参考同目录 .example）；
  // 生产用环境变量注入，层级用双下划线：ApiKey、OsuApi__ClientSecret、ConnectionStrings__DefaultConnection。
  "ApiKey": "",
  "OsuApi": {
    "ClientId": 24578,
    "ClientSecret": "",
    "RateLimitPerMinute": 50,
    "QueueLimit": 100
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=hitcircleapi;User=root;Password=;",
    "Redis": "localhost:6379,defaultDatabase=1"
  },
  "CacheDir": "cache",
  "Rendering": {
    // 渲染并发上限。调用方（bot）的 worker 数应 <= 此值，这样 503 才是安全网而不是常态。
    "MaxConcurrency": 4,
    "TimeoutMs": 8000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
