{
  // 复制为 appsettings.Development.json 后填入真实值。
  // 那个文件名已被 .gitignore 忽略 —— 不要把它提交上来。
  "ApiKey": "<自拟一个高强度随机串>",
  "OsuApi": {
    "ClientId": 24578,
    "ClientSecret": "<osu! 账号设置 → OAuth 应用 里的 Client Secret>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=hitcircleapi;User=root;Password=<MySQL 密码>;",
    "Redis": "localhost:6379,defaultDatabase=1"
  },
  "CacheDir": "cache",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}
